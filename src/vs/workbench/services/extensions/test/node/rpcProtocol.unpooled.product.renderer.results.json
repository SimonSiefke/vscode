	"harnessSource": {
		"rpc-renderer-main.cjs": "Buffer.poolSize=8*1024;for(let i=0;i<256;i++){if(Buffer.allocUnsafe(512).buffer.byteLength===Buffer.poolSize)break;}\nconst {app,utilityProcess,MessageChannelMain,BrowserWindow,ipcMain}=require('electron');const fs=require('node:fs');\napp.commandLine.appendSwitch('disable-renderer-backgrounding');app.commandLine.appendSwitch('disable-background-timer-throttling');\napp.whenReady().then(async()=>{\n const root='/home/simon/.cache/vscode-ipc-opt-20261022';const module=process.env.RPC_MODULE||'vs/workbench/services/extensions/common/rpcProtocol.js';const native=process.env.NATIVE==='1';\n const child=utilityProcess.fork('/tmp/ipc-opt-12h-20261022/rpc-renderer-worker.cjs',[],{stdio:'pipe',serviceName:'RPC renderer benchmark'});const {port1,port2}=new MessageChannelMain();\n const ready=new Promise((resolve,reject)=>{child.once('message',msg=>msg.error?reject(new Error(msg.error)):resolve(msg));child.once('exit',code=>reject(new Error('worker exit '+code)));});child.postMessage({root,module,native},[port2]);\n const window=new BrowserWindow({show:false,webPreferences:{preload:'/tmp/ipc-opt-12h-20261022/rpc-renderer-preload.cjs',nodeIntegration:false,contextIsolation:false,sandbox:false,webSecurity:false,backgroundThrottling:false}});\n window.webContents.on('console-message',details=>{if(details.level==='error')console.error(details.message);});\n const result=new Promise((resolve,reject)=>ipcMain.once('benchmark-result',(event,result)=>result.error?reject(new Error(result.error)):resolve(result)));\n await window.loadFile('/tmp/ipc-opt-12h-20261022/rpc-renderer.html');const worker=await ready;window.webContents.postMessage('benchmark-start',{root,module,native},[port1]);\n const data=await result;fs.writeFileSync(process.env.OUTPUT,JSON.stringify({...data,versions:process.versions,poolSize:Buffer.poolSize,worker},null,2));child.kill();window.destroy();app.quit();\n}).catch(error=>{console.error(error);app.exit(1);});\n",
		"rpc-renderer-preload.cjs": "const {ipcRenderer}=require('electron');\nipcRenderer.on('benchmark-start',(event,data)=>window.postMessage({event:'benchmark-start',...data},'*',event.ports));\nwindow.reportBenchmark=result=>ipcRenderer.send('benchmark-result',result);\n",
		"rpc-renderer.html": "<!DOCTYPE html><script type=\"module\">\nwindow.addEventListener('message',async event=>{\n if(event.data.event!=='benchmark-start')return;\n try{\n const {root,module,native}=event.data;const load=p=>import('file://'+root+'/out/'+p);\n const [{RPCProtocol},{ProxyIdentifier},{VSBuffer},{Emitter}]=await Promise.all([load(module),load('vs/workbench/services/extensions/common/proxyIdentifier.js'),load('vs/base/common/buffer.js'),load('vs/base/common/event.js')]);\n const {wrapStructuredCloneMessage}=await load('vs/base/parts/ipc/common/ipc.js');const port=event.ports[0];const binary=new Emitter();const objects=new Emitter();\n const traffic={sent:0,received:0,wireBytes:0,sentBackingBytes:0,receivedBackingBytes:0};\n port.onmessage=e=>{traffic.received++;if(ArrayBuffer.isView(e.data)){traffic.wireBytes+=e.data.byteLength;traffic.receivedBackingBytes+=e.data.buffer.byteLength;binary.fire(VSBuffer.wrap(e.data));}else{binary.fire(wrapStructuredCloneMessage(e.data));}};port.start();\n const protocol={send:msg=>{traffic.sent++;traffic.wireBytes+=msg.byteLength;traffic.sentBackingBytes+=msg.buffer.buffer.byteLength;port.postMessage(msg.buffer);},onMessage:binary.event,...(native?{sendStructuredClone:msg=>{traffic.sent++;port.postMessage(msg);}}:{})};\n const client=new RPCProtocol(protocol);const id=new ProxyIdentifier('electron-benchmark');const proxy=client.getProxy(id);\n const settings=Object.fromEntries(Array.from({length:100},(_,i)=>['editor.setting'+i,{enabled:true,value:i,scopes:['user','workspace']}]));const results=[];\n for(const [name,value] of [['primitive',42],['small-object',{command:'open',options:{pinned:true},ids:[1,2,3]}],['settings-100',settings],['text-4KiB','a'.repeat(4096)]]){\n const check=last=>{if(JSON.stringify(last)!==JSON.stringify(value))throw new Error('mismatch '+name);};\n check(await proxy.$echo(value));for(let i=0;i<200;i++)await proxy.$echo(value);for(const k in traffic)traffic[k]=0;const times=[];\n for(let s=0;s<3;s++){const start=performance.now();let last;for(let i=0;i<1000;i++)last=await proxy.$echo(value);times.push(performance.now()-start);check(last);}\n results.push({name,microsecondsPerRoundTrip:times,...traffic});}\n window.reportBenchmark({module,native,hasBuffer:typeof Buffer!=='undefined',results});client.dispose();port.close();\n }catch(error){window.reportBenchmark({error:String(error.stack)});}\n});\n</script>\n",
		"rpc-renderer-worker.cjs": "Buffer.poolSize=8*1024;for(let i=0;i<256;i++){if(Buffer.allocUnsafe(512).buffer.byteLength===Buffer.poolSize)break;}\nconst {pathToFileURL}=require('node:url');\nprocess.parentPort.once('message',async event=>{\n try{\n  const {root,module,native}=event.data;const load=p=>import(pathToFileURL(root+'/out/'+p).href);\n  const [{RPCProtocol},{ProxyIdentifier},{VSBuffer},{Event}]=await Promise.all([load(module),load('vs/workbench/services/extensions/common/proxyIdentifier.js'),load('vs/base/common/buffer.js'),load('vs/base/common/event.js')]);\n  const {wrapStructuredCloneMessage}=await load('vs/base/parts/ipc/common/ipc.js');const port=event.ports[0];const protocol={send:msg=>port.postMessage(msg.buffer),onMessage:Event.fromNodeEventEmitter(port,'message',e=>ArrayBuffer.isView(e.data)?VSBuffer.wrap(e.data):wrapStructuredCloneMessage(e.data)),...(native?{sendStructuredClone:msg=>port.postMessage(msg)}:{})};port.start();\n  const server=new RPCProtocol(protocol);const id=new ProxyIdentifier('electron-benchmark');server.set(id,{$echo:value=>value});\n  process.parentPort.postMessage({ready:true,node:process.version,poolSize:Buffer.poolSize});\n }catch(error){process.parentPort.postMessage({error:String(error.stack)});}\n});\n"
