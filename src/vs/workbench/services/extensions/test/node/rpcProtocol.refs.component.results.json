	"harnessSource": "import assert from 'node:assert/strict';import {pathToFileURL} from 'node:url';\nconst root='/home/simon/.cache/vscode-ipc-opt-20261022';const load=p=>import(pathToFileURL(root+'/out/'+p).href);const module=process.env.RPC_MODULE||'vs/workbench/services/extensions/common/rpcProtocol.before-refs.js';\nconst {parseJsonAndRestoreBufferRefs:parse,stringifyJsonWithBufferRefs:stringify}=await load(module);const {VSBuffer}=await load('vs/base/common/buffer.js');\nconst fixtures=[['settings-100',Object.fromEntries(Array.from({length:100},(_,i)=>['s'+i,{value:i,enabled:true,scopes:['user','workspace']}]))],['workspace-edits-100',{edits:Array.from({length:100},(_,i)=>({resource:{$mid:1,scheme:'file',path:'/workspace/file'+i},edit:{range:{startLineNumber:i+1,startColumn:1,endLineNumber:i+1,endColumn:10},text:'replacement '+i,eol:undefined},metadata:{label:'edit '+i,needsConfirmation:undefined}}))}],['notebook-100',{cells:Array.from({length:100},(_,i)=>({language:'markdown',source:'cell '+i,metadata:undefined,outputs:[{mime:'text/plain',data:VSBuffer.fromString('output '+i)}]}))}]];\nconst results=[];for(const[name,value]of fixtures){const{jsonString,referencedBuffers}=stringify(value);for(let i=0;i<200;i++)parse(jsonString,referencedBuffers,null);const times=[];for(let s=0;s<3;s++){const start=performance.now();let last;for(let i=0;i<1000;i++)last=parse(jsonString,referencedBuffers,null);times.push(performance.now()-start);assert.ok(last);}results.push({name,jsonCharacters:jsonString.length,buffers:referencedBuffers.length,microsecondsPerParse:times});}console.log(JSON.stringify({node:process.version,module,results}));\n",
	"sourceNote": "The parser module hash identifies the measured implementation. The component/renderer harnesses do not execute the Node benchmark file; its logged hash is context only."
