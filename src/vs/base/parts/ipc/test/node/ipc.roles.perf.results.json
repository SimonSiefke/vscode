	"harnessSource": "import assert from 'node:assert/strict';import {MessageChannel} from 'node:worker_threads';import {pathToFileURL} from 'node:url';import {Buffer} from 'node:buffer';\nBuffer.poolSize=8192;for(let i=0;i<256;i++){if(Buffer.allocUnsafe(512).buffer.byteLength===8192)break;}\nconst root='/home/simon/.cache/vscode-ipc-opt-20261022';const load=p=>import(pathToFileURL(root+'/out/'+p).href);const{IPCClient}=await load(process.env.IPC_MODULE);const{VSBuffer}=await load('vs/base/common/buffer.js');const{Event}=await load('vs/base/common/event.js');const{DisposableStore,toDisposable}=await load('vs/base/common/lifecycle.js');\nconst transport=process.env.TRANSPORT||'native';const fixtures=[['primitive',42],['small-object',{command:'open',options:{pinned:true},ids:[1,2,3]}],['settings-100',Object.fromEntries(Array.from({length:100},(_,i)=>['s'+i,{enabled:true,value:i,scopes:['user','workspace']}]))],['keys-1000',Array.from({length:1000},(_,i)=>'key'+i)]];const results=[];\nfor(const[name,value]of fixtures){const store=new DisposableStore();const{port1,port2}=new MessageChannel();store.add(toDisposable(()=>{port1.close();port2.close();}));const protocol=port=>transport==='native'?{type:'structuredClone',send:msg=>port.postMessage(msg),onMessage:Event.fromNodeEventEmitter(port,'message',msg=>msg)}:{send:msg=>port.postMessage(msg.buffer),onMessage:Event.fromNodeEventEmitter(port,'message',bytes=>VSBuffer.wrap(bytes))};const first=store.add(new IPCClient(protocol(port1),'first'));const second=store.add(new IPCClient(protocol(port2),'second'));const echo={call:async(_ctx,_name,arg)=>arg,listen:()=>Event.None};first.registerChannel('echo',echo);second.registerChannel('echo',echo);const channel=first.getChannel('echo');assert.deepStrictEqual(await channel.call('echo',value),value);for(let i=0;i<200;i++)await channel.call('echo',value);const times=[];for(let sample=0;sample<3;sample++){const start=performance.now();let last;for(let i=0;i<1000;i++)last=await channel.call('echo',value);times.push(performance.now()-start);assert.deepStrictEqual(last,value);}results.push({name,microsecondsPerRoundTrip:times});store.dispose();}\nconsole.log(JSON.stringify({node:process.version,poolSize:Buffer.poolSize,module:process.env.IPC_MODULE,transport,results}));\n"
