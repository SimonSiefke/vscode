+const enum MessageType {
+	RequestJSONArgs = 1,
+	RequestJSONArgsWithCancellation = 2,
+	RequestMixedArgs = 3,
+	RequestMixedArgsWithCancellation = 4,
+	Acknowledged = 5,
+	Cancel = 6,
+	ReplyOKEmpty = 7,
+	ReplyOKVSBuffer = 8,
+	ReplyOKJSON = 9,
+	ReplyOKJSONWithBuffers = 10,
+	ReplyErrError = 11,
+	ReplyErrEmpty = 12,
+	NotificationJSONArgs = 13,
+	ReplyOKScalar = 14,
+	RequestScalarArg = 15,
+	RequestScalarArgWithCancellation = 16,
+}
+
